# Git server (leave empty until you connect a real host)
ISKELE_GIT_BASE_URL=
ISKELE_GIT_TOKEN=

# Persistent volume: checkouts under $ISKELE_DATA_DIR/repos/<repo>/<branch>
ISKELE_DATA_DIR=./data
ISKELE_DATABASE_PATH=./data/iskele.db
ISKELE_JWT_SECRET=change-me-in-production
ISKELE_JWT_EXPIRE_HOURS=12

# First admin (this role can create users)
ISKELE_ADMIN_USERNAME=admin
ISKELE_ADMIN_PASSWORD=admin
ISKELE_ADMIN_DISPLAY_NAME=Admin

# Docker host display name used when building service URLs
ISKELE_DOCKER_HOST=localhost

# Bind
ISKELE_HOST=127.0.0.1
ISKELE_PORT=8000
